{
  "manifest_version": 3,
  "name": "Lumina Magnifier",
  "version": "1.2.0",
  "description": "Magnify any page or photo with a premium lens — custom size and zoom, circle/square/rectangle shapes, docked lens, follow-caret mode, contrast boost, colour picker and more.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "scripting", "contextMenus", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Lumina Magnifier",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "commands": {
    "toggle-magnifier": {
      "suggested_key": { "default": "Alt+M" },
      "description": "Toggle the magnifier lens on the current page"
    }
  }
}
